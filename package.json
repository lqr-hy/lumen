{
  "name": "ai-campaign-page-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "electron:dev": "VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.mjs",
    "electron:dev:debug": "VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.mjs",
    "build": "tsc -b && vite build",
    "build:dmg": "npm run build && electron-builder --mac dmg",
    "test:agent-design": "node scripts/test-agent-design-flow.mjs",
    "test:agent-reliability": "node scripts/test-agent-runtime-reliability.mjs",
    "test:agent-upgrades": "node scripts/test-agent-upgrades.mjs",
    "test:image-provider": "node scripts/test-image-provider.mjs",
    "test:image-skill": "node scripts/test-design-image-generation-skill.mjs",
    "test:raster-analysis": "node scripts/test-raster-analysis.mjs",
    "test:pi-direct": "node scripts/test-pi-direct-provider.mjs",
    "test:pi-runtime": "node scripts/test-pi-runtime.mjs",
    "test:pi-context": "node scripts/test-pi-context-policy.mjs",
    "test:turn-budget": "node scripts/test-turn-budget.mjs",
    "test:canvas-lease": "node scripts/test-canvas-lease.mjs",
    "test:canvas-rebase": "node scripts/test-canvas-rebase.mjs",
    "test:chat-run": "node scripts/test-chat-run.mjs",
    "test:canvas-target": "node scripts/test-canvas-target-resolver.mjs",
    "test:generic-ui": "node scripts/test-generic-ui-flow.mjs",
    "test:generic-ui-incremental": "node scripts/test-generic-ui-incremental.mjs",
    "test:scene-graph": "node scripts/test-scene-graph.mjs",
    "test:design-patch": "node scripts/test-design-patch.mjs",
    "test:inspector-layout": "node scripts/test-inspector-layout.mjs",
    "test:layer-tree": "node scripts/test-layer-tree.mjs",
    "test:canvas-performance": "node scripts/test-canvas-performance.mjs",
    "test:inspector-schema": "node scripts/test-inspector-schema.mjs",
    "test:design-spec-patch": "node scripts/test-design-spec-patch.mjs",
    "test:e2e": "playwright test",
    "test:e2e:visual-optimization": "playwright test tests/e2e/visual-optimization.spec.ts --project=desktop-chrome",
    "test:visual-regression": "playwright test tests/e2e/responsive-visual.spec.ts --project=desktop-chrome",
    "test:codegen-parity": "playwright test tests/e2e/codegen-parity.spec.ts --project=desktop-chrome",
    "test:snapshot-gate": "playwright test tests/e2e/artboard-snapshot.spec.ts --project=desktop-chrome",
    "test:component-canvas": "node scripts/test-component-canvas.mjs",
    "test:component-actions": "node scripts/test-component-actions.mjs",
    "test:component-export": "node scripts/test-component-export.mjs",
    "test:design-pipeline": "node scripts/test-design-development-pipeline.mjs",
    "test:design-eval": "node scripts/test-design-eval.mjs",
    "test:layered-design-gates": "node scripts/test-layered-design-gates.mjs",
    "test:page-agent": "node scripts/test-page-agent-flow.mjs",
    "test:component-design": "node scripts/test-component-design-flow.mjs",
    "test:component-packs": "node scripts/test-component-packs.mjs",
    "test:component-plugin": "node scripts/test-component-plugin-boundary.mjs",
    "test:component-runtime-inspector": "electron scripts/test-component-runtime-inspector.mjs",
    "test:runtime-dom-adapter": "node scripts/test-runtime-dom-adapter.mjs",
    "test:static-ui-runtime": "electron scripts/test-static-ui-runtime.mjs",
    "test:user-extensions": "node scripts/test-user-extensions.mjs",
    "test:render-ir": "node scripts/test-render-ir.mjs",
    "test:visual-brief": "node scripts/test-visual-brief.mjs",
    "test:codegen": "node scripts/test-codegen.mjs",
    "test:all": "npm run test:agent-design && npm run test:agent-reliability && npm run test:agent-upgrades && npm run test:image-provider && npm run test:image-skill && npm run test:raster-analysis && npm run test:pi-direct && npm run test:pi-runtime && npm run test:pi-context && npm run test:turn-budget && npm run test:canvas-lease && npm run test:canvas-rebase && npm run test:chat-run && npm run test:canvas-target && npm run test:generic-ui && npm run test:generic-ui-incremental && npm run test:scene-graph && npm run test:runtime-dom-adapter && npm run test:design-patch && npm run test:design-spec-patch && npm run test:component-packs && npm run test:component-plugin && npm run test:user-extensions && npm run test:component-actions && npm run test:component-canvas && npm run test:component-design && npm run test:component-export && npm run test:design-pipeline && npm run test:design-eval && npm run test:layered-design-gates && npm run test:layer-tree && npm run test:canvas-performance && npm run test:page-agent && npm run test:render-ir && npm run test:visual-brief && npm run test:codegen && npm run lint && npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \"electron/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\" \"electron/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{json,md}\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-session-backend-sqlite-node": "0.85.1",
    "@lexical/react": "^0.49.0",
    "@types/prismjs": "^1.26.6",
    "adm-zip": "^0.6.0",
    "framer-motion": "^12.23.6",
    "jpeg-js": "^0.4.4",
    "lexical": "^0.49.0",
    "lucide-react": "^0.525.0",
    "pngjs": "^7.0.0",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.1.0",
    "react-dom18": "npm:react-dom@^18.3.1",
    "react-moveable": "^0.56.0",
    "react-router-dom": "^7.6.3",
    "react18": "npm:react@^18.3.1",
    "scheduler18": "npm:scheduler@^0.23.2",
    "vue": "^2.7.16",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.62.0",
    "@types/adm-zip": "^0.5.8",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "sass": "^1.101.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.3"
  },
  "build": {
    "appId": "com.bilibili.ai-campaign-page-studio",
    "productName": "AI Campaign Page Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".agents/skills",
        "to": "skills"
      },
      {
        "from": "componentsJson",
        "to": "componentsJson"
      },
      {
        "from": "component-packs",
        "to": "component-packs"
      },
      {
        "from": "style-packs",
        "to": "style-packs"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "identity": null,
      "target": "dmg"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
