# 环境变量名称示例。正式 Runtime 直接读取启动 Electron 的 process.env，
# 不要在此文件或任何 VITE_* 变量中写入真实 Key。

# B 站 OpenAI Images 兼容生图接口：
BILI_IMAGE_BASE_URL=http://llmapi.bilibili.co/v1
BILI_IMAGE_API_KEY=your-bili-image-key

# 浏览器直连测试模式：
# 注意：VITE_ 变量会暴露到浏览器 Network 里，只适合你现在本地测试。
# 后期打包成 DMG 时，应改成 Electron/Tauri 主进程代理请求，避免 key 暴露。
# VITE_AICODING_DIRECT=true
# VITE_AICODING_BASE_URL=http://api-ai-coding.bilibili.co/api/v1/codex
# VITE_AICODING_MODE=responses
# VITE_AICODING_API_KEY=your-aicoding-key
# VITE_AICODING_MODEL=gpt-5

# 浏览器直连 B 站 Copilot prediction 接口：
# VITE_AICODING_DIRECT=true
# VITE_AICODING_BASE_URL=https://copilot.bilibili.co/api/v1/prediction/e3558bcf-64ee-4522-85a5-e07ccfc7d99f
# VITE_AICODING_MODE=copilot

# B 站 aicoding Codex 接口，对应 ~/.codex/config.toml:
# [model_providers.aicoding]
# base_url = "http://api-ai-coding.bilibili.co/api/v1/codex"
# wire_api = "responses"
# env_key = "AICODING_API_KEY"
AICODING_BASE_URL=http://api-ai-coding.bilibili.co/api/v1/codex
CODEX_API_MODE=responses
AICODING_API_KEY=your-aicoding-key
# CODEX_MODEL=gpt-5

# B 站 Copilot prediction 接口：
# CODEX_API_URL=https://copilot.bilibili.co/api/v1/prediction/e3558bcf-64ee-4522-85a5-e07ccfc7d99f
# CODEX_API_MODE=copilot

# OpenAI Responses API 格式：
# CODEX_API_URL=https://api.openai.com/v1/responses
# CODEX_API_MODE=responses
# CODEX_API_KEY=sk-...
# CODEX_MODEL=gpt-4.1-mini

# OpenAI Chat Completions 兼容本地接口：
# CODEX_API_URL=http://127.0.0.1:11434/v1/chat/completions
# CODEX_API_MODE=chat
# CODEX_MODEL=qwen2.5-coder
# CODEX_API_ALLOW_NO_KEY=true

# model + input 格式的内部/本地接口：
# CODEX_API_URL=http://127.0.0.1:3000/api/v1/codex
# CODEX_API_MODE=input
# CODEX_API_KEY=your-local-key
# CODEX_MODEL=your-model
