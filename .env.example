# 环境变量名称示例。正式 Runtime 直接读取启动 Electron 的 process.env，
# 不要在此文件或任何 VITE_* 变量中写入真实 Key。

# OpenAI Images 兼容生图接口：
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=your-image-key

# aicoding Codex 接口；也可只在 ~/.codex/config.toml 配置：
# [model_providers.aicoding]
# base_url = "https://your-codex-gateway.example/v1"
# wire_api = "responses"
# env_key = "AICODING_API_KEY"
AICODING_BASE_URL=https://your-codex-gateway.example/v1
AICODING_API_KEY=your-aicoding-key

# 标准 OpenAI Responses API：
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
